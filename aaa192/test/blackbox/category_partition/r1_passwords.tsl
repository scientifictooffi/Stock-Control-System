# Category Partition specification for
# stock_control/reporting/passwords.py::hash_password and hash_for_user
# (R1 follow-up: password hashing)
# Run: TSLgenerator -s r1_passwords.tsl

Parameters:
  Password:
    empty.                       [error]
    not a string.                [error]
    one character.               [single]
    normal text.                 [property normal]

  Salt:
    not given.                   [if normal]
    valid hex.                   [if normal]
    empty.                       [error]
    not hex.                     [error]

  User at login:
    unknown user.                [single]
    stored hashed.               [if normal]
    stored in plain text.        [single]
    stored value not salt and hash.   [single]

  Typed password:
    same as stored.              [if normal]
    one character different.     [if normal]
    different letter case.       [single]
    empty.                       [error]
